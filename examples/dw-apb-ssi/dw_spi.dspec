device dw-apb-ssi {
  class generic_mmio
  source "/home/yfblock/Code/dri-trans-paper/reharness/benchmarks/drivers/multisource/dw-apb-ssi.json"
  state {
    base: MmioBase
    clk: Clock
    num_irqs: UInt
  }
  resource transaction0: TransactionResource { required true bind regmap }
  resource clk0: ClockResource { required true bind clk }
  resource irq0: IrqResource { required true }
  register DW_SPI_CTRLR0: B4 at base + 0x0
  register DW_SPI_CTRLR1: B4 at base + 0x4
  register DW_SPI_SSIENR: B4 at base + 0x8
  register DW_SPI_SER: B4 at base + 0x10
  register DW_SPI_BAUDR: B4 at base + 0x14
  register MSCC_SPI_MST_SW_MODE: B4 at base + 0x14
  register DW_SPI_TXFTLR: B4 at base + 0x18
  register DW_SPI_RXFTLR: B4 at base + 0x1c
  register DW_SPI_TXFLR: B4 at base + 0x20
  register DW_SPI_RXFLR: B4 at base + 0x24
  register DW_SPI_SR: B4 at base + 0x28
  register DW_SPI_IMR: B4 at base + 0x2c
  register DW_SPI_ISR: B4 at base + 0x30
  register DW_SPI_RISR: B4 at base + 0x34
  register DW_SPI_ICR: B4 at base + 0x48
  register DW_SPI_VERSION: B4 at base + 0x5c
  register DW_SPI_RX_SAMPLE_DLY: B4 at base + 0xf0
  register DW_SPI_CS_OVERRIDE: B4 at base + 0xf4
  invariant forall line: UInt. line < num_irqs -> valid_interrupt_line(line)
  function dw_spi_set_cs(spi: DeviceState, enable: UInt) -> Void {
    role unknown
    source "spi-dw-core.c:90"
    context thread
    callback spi_controller.set_cs
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_set_cs
    effect writes_register(DW_SPI_SER)
  }
  function dw_spi_check_status(dws: DeviceState, raw: UInt) -> UInt {
    role unknown
    source "spi-dw-core.c:177"
    context thread
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_check_status
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
  }
  function dw_spi_transfer_handler(dws: DeviceState) -> UInt {
    role interrupt_handler
    source "spi-dw-core.c:213"
    context irq
    callback dw_spi.transfer_handler
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_transfer_handler
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_RXFTLR)
    effect handles_interrupt()
    ensure interrupt_serviced
  }
  function dw_spi_irq(irq: UInt, dev_id: DeviceState) -> UInt {
    role interrupt_handler
    source "spi-dw-core.c:251"
    context irq
    callback irq_handler.handler
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_irq
    effect writes_register(DW_SPI_IMR)
    effect handles_interrupt()
    ensure interrupt_serviced
  }
  function dw_spi_update_config(dws: DeviceState, spi: DeviceState, cfg: DeviceState) -> Void {
    role unknown
    source "spi-dw-core.c:315"
    context thread
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_update_config
    effect writes_register(DW_SPI_CTRLR0)
    effect writes_register(DW_SPI_CTRLR1)
    effect writes_register(DW_SPI_BAUDR)
    effect writes_register(DW_SPI_RX_SAMPLE_DLY)
  }
  function dw_spi_transfer_one(ctlr: DeviceState, spi: DeviceState, transfer: DeviceState) -> UInt {
    role unknown
