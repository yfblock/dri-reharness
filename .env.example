# reharness LLM configuration
#
# Since the switch to Pi Agent as the unified generation backend,
# model and API key configuration lives in .reharness/pi/:
#   .reharness/pi/models.json  - provider + model definition (safe to commit)
#   .reharness/pi/auth.json    - API keys (NEVER commit, already in .gitignore)
#
# This .env file only provides an optional model hint for pi_synth.sh.
# Format: provider/model_id (Pi registry format)
# If omitted, Pi uses the first available model from the config.
REHARNESS_LLM_MODEL=yfblock/glm-5.2-highspeed

# Set to 1 to enable LLM generation by default
REHARNESS_USE_LLM=1
