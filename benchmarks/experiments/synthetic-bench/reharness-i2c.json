{
  "schema": 2,
  "name": "reharness-i2c",
  "source": {
    "path": "benchmarks/drivers/fixtures/reharness-i2c-sensor.c"
  },
  "compile": {
    "backend": "linux",
    "language": "c",
    "context": "kbuild"
  },
  "runtime": {
    "adapter": "qemu-profile",
    "profile": "i2c-generic",
    "capabilities": {
      "required": ["registration", "probe", "transaction", "unload"]
    },
    "registration": {
      "root_table": "i2c_driver",
      "identity_field": "driver_name",
      "device_id_tables": ["i2c_device_id"]
    },
    "fixture": {
      "kind": "qemu-i2c",
      "config": {
        "address": "0x50",
        "register": "0x10",
        "expected_value": "0x5a"
      },
      "module_sources": [
        "qa/verification/device-registrar/i2c-registrar.c"
      ]
    },
    "qemu": {
      "machine": "pc",
      "device": "i2c-virtual",
      "bus": "i2c",
      "module": "reharness_i2c_sensor",
      "timeout_seconds": 90,
      "probe_pattern": "REHARNESS_I2C_DRIVER_PROBE",
      "binding": {
        "bus": "i2c",
        "device_glob": "*"
      },
      "kernel_modules": ["i2c-dev"]
    }
  },
  "test": {
    "subsystem": {
      "name": "i2c",
      "tests": [
        {
          "name": "i2c-transaction",
          "executable": "qa/native-tests/i2c_transaction_test.c",
          "args": ["/dev/reharness-i2c-control"],
          "success_pattern": "I2C_TRANSACTION_PASS"
        },
        {
          "name": "i2c-invalid-address",
          "executable": "qa/native-tests/i2c_transaction_test.c",
          "args": ["/dev/reharness-i2c-control"],
          "success_pattern": "I2C_INVALID_ADDRESS_PASS"
        },
        {
          "name": "linux-i2c-dev-tool",
          "provider": "linux-i2c-dev",
          "args": ["/dev/i2c-0"]
        }
      ]
    }
  },
  "trace": {
    "fields": ["phase", "function", "kind", "width_bits", "address", "value", "sequence"]
  },
  "limits": {
    "compile": 3,
    "runtime": 3,
    "trace": 3
  }
}
