{
  "schema": 2,
  "name": "edu",
  "source": {
    "path": "benchmarks/drivers/baseline/edu.c"
  },
  "compile": {
    "backend": "linux",
    "language": "c",
    "context": "kbuild"
  },
  "runtime": {
    "adapter": "qemu-profile",
    "pci_identity": {
      "vendor": "0x1234",
      "device": "0x11e8"
    },
    "registration": {
      "root_table": "pci_driver",
      "identity_field": "driver_name"
    },
    "safety_policy": {
      "forbidden_tokens": ["IO_DMA_CMD", "DMA_CMD | DMA_IRQ"],
      "action": "rewrite",
      "failure_class": "safety",
      "rewrite_rules": [
        {
          "pattern": "^[ \\t]*writel\\([^;]*(?:IO_DMA_CMD|DMA_CMD\\s*\\|\\s*DMA_IRQ)[^;]*\\);[ \\t]*\\n",
          "replacement": ""
        }
      ]
    },
    "qemu": {
      "machine": "pc",
      "device": "edu",
      "bus": "pci",
      "module": "edu_drv",
      "timeout_seconds": 90,
      "launch_device": true,
      "binding": {
        "bus": "pci",
        "device_glob": "*"
      }
    }
  },
  "test": {
    "executable": "qa/native-tests/edu_trace_test",
    "args": ["/dev/edu_drv"],
    "actions": [
      {"name": "open"},
      {"name": "read"},
      {"name": "write"}
    ],
    "success_pattern": "EDU_TRACE_OK"
  },
  "trace": {
    "fields": ["phase", "function", "kind", "width_bits", "address", "value", "sequence"],
    "value_mask": "0xffffffff",
    "instrument": true
  },
  "limits": {
    "compile": 3,
    "runtime": 3,
    "trace": 3
  }
}
