# Generated RIS output
/artifacts/output/
/artifacts/initramfs/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# benchmarks/drivers/ is the versioned evaluation corpus.
# vendor/linux/ is the pinned, initialized Git submodule (see .gitmodules).

# Editor / OS cruft
*.swp
*.swo
*~
.*.un~
.DS_Store

# QEMU/build artifacts (regenerable)
/platform/rootfs/
/qa/native-tests/edu_trace_test
/qa/native-tests/gpio_trace_test
/platform/kernel/build/
*.ko
*.o
*.mod
*.mod.c
*.cmd
Module.symvers
modules.order

# LaTeX intermediates (the source and final PDF remain versioned)
/research/paper/*.aux
/research/paper/*.log
/research/paper/*.out
/research/paper/*.fls
/research/paper/*.fdb_latexmk
/research/paper/comment.cut
# Pi SDK dependencies live with the Pi tool
/tools/pi/node_modules/
/tools/pi/package-lock.json

# LLM secrets (use .env.example as template)
.env

# Project-level Pi config: models.json is safe to commit, auth.json contains secrets
.reharness/pi/auth.json
