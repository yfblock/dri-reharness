\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Composition of non-blank lines per driver, measured by source-line provenance of emitted operations. Device-core lines are referenced by $\ge $1 recorded operation; framework entry bodies are the non-core lines of callback and lifecycle functions; glue wrappers and helpers are remaining function bodies; file-scope lines are declarations, macros, and registration tables outside functions (blank lines excluded). The aggregate is 9.5\%{} device-core versus 90.5\%{} integration. Line-level attribution is an approximation: a line interleaving a guard and a register access counts as device-core.}}{12}{figure.caption.27}\protected@file@percent }
\newlabel{fig:glue-ratio}{{3}{12}{Composition of non-blank lines per driver, measured by source-line provenance of emitted operations. Device-core lines are referenced by $\ge $1 recorded operation; framework entry bodies are the non-core lines of callback and lifecycle functions; glue wrappers and helpers are remaining function bodies; file-scope lines are declarations, macros, and registration tables outside functions (blank lines excluded). The aggregate is \GlueCorePct {} device-core versus \GlueGluePct {} integration. Line-level attribution is an approximation: a line interleaving a guard and a register access counts as device-core}{figure.caption.27}{}}
\newlabel{fig:glue-ratio@cref}{{[figure][3][]3}{[1][11][]12}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Readiness results. RIS = internal RIS quality heuristic (0--1), FuncSpec = function-spec quality, DevSpec = device-spec quality. H/B/L = harness / bare-metal / Linux compilation. Linux ready denotes strict artifact readiness; synthesis-eligible denotes sufficient context to attempt LLM synthesis. ``--'' means the check does not apply to that driver/backend (e.g., strict Linux readiness without a kernel-side lifecycle model); $\times $ means the check applied and failed; no ``--'' entry masks a failing check.}}{12}{table.caption.28}\protected@file@percent }
\newlabel{tab:readiness}{{3}{12}{Readiness results. RIS = internal RIS quality heuristic (0--1), FuncSpec = function-spec quality, DevSpec = device-spec quality. H/B/L = harness / bare-metal / Linux compilation. Linux ready denotes strict artifact readiness; synthesis-eligible denotes sufficient context to attempt LLM synthesis. ``--'' means the check does not apply to that driver/backend (e.g., strict Linux readiness without a kernel-side lifecycle model); $\times $ means the check applied and failed; no ``--'' entry masks a failing check}{table.caption.28}{}}
\newlabel{tab:readiness@cref}{{[table][3][]3}{[1][11][]12}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Compilation versus strict artifact readiness across the 19{}-driver evaluation. Blue bars count compilable deterministic outputs; orange bars count artifacts passing the modeled strict gate. Compilation is necessary but not sufficient, and neither result establishes whole-driver equivalence.}}{12}{figure.caption.30}\protected@file@percent }
\newlabel{fig:readiness-gap}{{4}{12}{Compilation versus strict artifact readiness across the \EvalDrivers {}-driver evaluation. Blue bars count compilable deterministic outputs; orange bars count artifacts passing the modeled strict gate. Compilation is necessary but not sufficient, and neither result establishes whole-driver equivalence}{figure.caption.30}{}}
