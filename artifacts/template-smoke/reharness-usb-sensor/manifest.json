{
  "compile": {
    "backend": "linux",
    "context": "kbuild",
    "language": "c"
  },
  "limits": {
    "compile": 3,
    "runtime": 3,
    "trace": 3
  },
  "name": "reharness_usb_sensor",
  "runtime": {
    "adapter": "qemu-profile",
    "capabilities": {
      "optional": [
        "subsystem",
        "trace"
      ],
      "required": [
        "registration",
        "probe",
        "transfer",
        "unload"
      ]
    },
    "fixture": {
      "config": {
        "driver_name": "reharness_usb_sens",
        "product_id": "0x6001",
        "vendor_id": "0x0403"
      },
      "kind": "qemu-usb"
    },
    "profile": "usb-generic",
    "qemu": {
      "binding": {
        "bus": "usb",
        "device_glob": "*"
      },
      "bus": "usb",
      "device": "qemu-xhci",
      "kernel_modules": [
        "xhci-hcd",
        "xhci-pci",
        "udc-core",
        "dummy_hcd",
        "libcomposite",
        "usb_f_ss_lb",
        "g_zero",
        "usbtest"
      ],
      "launch_device": false,
      "machine": "pc",
      "module": "reharness_usb_sensor",
      "probe_pattern": "REHARNESS_USB_DRIVER_PROBE",
      "qemu_args": [
        "-chardev",
        "null,id=reharness_usb_char",
        "-device",
        "qemu-xhci,id=reharness_xhci",
        "-device",
        "usb-serial,bus=reharness_xhci.0,chardev=reharness_usb_char,always-plugged=true"
      ],
      "timeout_seconds": 90
    }
  },
  "schema": 2,
  "source": {
    "path": "benchmarks/drivers/fixtures/reharness-usb-sensor.c",
    "sha256": "b2694440ba132e19c52c74f468834f35f4b02aee22e491951886783682d97133"
  },
  "test": {
    "subsystem": {
      "name": "usb",
      "tests": [
        {
          "args": [
            "/dev/reharness-usb-control",
            "control"
          ],
          "executable": "qa/native-tests/usb_transaction_test.c",
          "name": "usb-control-status",
          "success_pattern": "USB_CONTROL_PASS"
        },
        {
          "args": [
            "/dev/reharness-usb-control",
            "bulk"
          ],
          "executable": "qa/native-tests/usb_transaction_test.c",
          "name": "usb-bulk-out",
          "success_pattern": "USB_BULK_OUT_PASS"
        },
        {
          "args": [
            "/dev/reharness-usb-control",
            "invalid"
          ],
          "executable": "qa/native-tests/usb_transaction_test.c",
          "name": "usb-invalid-endpoint",
          "success_pattern": "USB_INVALID_ENDPOINT_PASS"
        },
        {
          "args": [
            "-a",
            "-t",
            "1",
            "-c",
            "1",
            "-s",
            "64"
          ],
          "executable": "vendor/linux/tools/usb/testusb.c",
          "kind": "tool",
          "module": "usbtest",
          "name": "linux-usbtest-gadget",
          "provider": "linux-usbtest",
          "required": true,
          "success_pattern": "test 1,"
        }
      ]
    }
  },
  "trace": {
    "fields": [
      "phase",
      "function",
      "kind",
      "width_bits",
      "address",
      "value",
      "sequence"
    ]
  }
}
