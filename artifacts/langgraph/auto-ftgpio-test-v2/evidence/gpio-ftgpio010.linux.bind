backend linux for device gpio-ftgpio010 {
  include <linux/io.h>
  include <linux/platform_device.h>
  type DeviceState -> "struct gpio_ftgpio010"
  type MmioBase -> "void __iomem *"
  type LogicalIRQ -> "struct irq_data *"
  type UInt -> "u32"
  type UIntPtr -> "unsigned long *"
  callback irq_chip.irq_ack = ftgpio_gpio_ack_irq
  callback irq_chip.irq_mask = ftgpio_gpio_mask_irq
  callback irq_chip.irq_unmask = ftgpio_gpio_unmask_irq
  callback irq_chip.irq_set_type = ftgpio_gpio_set_irq_type
  callback gpio_irq_chip.parent_handler = ftgpio_gpio_irq_handler
  callback gpio_chip.set_config = ftgpio_gpio_set_config
  callback platform_driver.probe = ftgpio_gpio_probe
  callback gpio_chip.get = ftgpio_gpio_probe__gpio_generic_get
  callback gpio_chip.get_multiple = ftgpio_gpio_probe__gpio_generic_get_multiple
  callback gpio_chip.set = ftgpio_gpio_probe__gpio_generic_set
  callback gpio_chip.set_multiple = ftgpio_gpio_probe__gpio_generic_set_multiple
  callback gpio_chip.direction_input = ftgpio_gpio_probe__gpio_generic_direction_input
  callback gpio_chip.direction_output = ftgpio_gpio_probe__gpio_generic_direction_output
  callback gpio_chip.get_direction = ftgpio_gpio_probe__gpio_generic_get_direction
  map dev.base -> "g->base"
  map MmioRead(B4) -> "readl"
  map MmioWrite(B4) -> "writel"
  map MmioRead(B2) -> "readw"
  map MmioWrite(B2) -> "writew"
  map MmioRead(B1) -> "readb"
  map MmioWrite(B1) -> "writeb"
  map MmioWriteW1C(B4) -> "writel"
  map MmioWriteW1C(B2) -> "writew"
  map MmioWriteW1C(B1) -> "writeb"
  map MmioReadBE(B2) -> "ioread16be"
  map MmioWriteBE(B2) -> "iowrite16be"
  map MmioReadBE(B4) -> "ioread32be"
  map MmioWriteBE(B4) -> "iowrite32be"
}
