source: /home/yfblock/Code/dri-trans-paper/reharness/benchmarks/drivers/baseline/sdhci-esdhc-mcf.c
includes:
  - linux/module.h
  - linux/delay.h
  - linux/platform_data/mmc-esdhc-mcf.h
  - linux/mmc/mmc.h
  - sdhci-pltfm.h
  - sdhci-esdhc.h
structs:
  pltfm_mcf_data:
    fields:
      clk_ipg: "struct clk *"
      clk_ahb: "struct clk *"
      clk_per: "struct clk *"
      aside: "int"
      current_bus_width: "int"
