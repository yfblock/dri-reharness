callbacks:
  sdhci_ops.reset: esdhc_mcf_reset
  sdhci_ops.set_clock: esdhc_mcf_pltfm_set_clock
  sdhci_ops.get_max_clock: esdhc_mcf_pltfm_get_max_clock
  sdhci_ops.get_min_clock: esdhc_mcf_pltfm_get_min_clock
  sdhci_ops.set_bus_width: esdhc_mcf_pltfm_set_bus_width
  sdhci_ops.get_max_timeout_count: esdhc_mcf_get_max_timeout_count
  sdhci_ops.set_timeout: esdhc_mcf_set_timeout
  sdhci_ops.write_b: esdhc_mcf_writeb_be
  sdhci_ops.write_w: esdhc_mcf_writew_be
  sdhci_ops.write_l: esdhc_mcf_writel_be
  sdhci_ops.read_b: esdhc_mcf_readb_be
  sdhci_ops.read_w: esdhc_mcf_readw_be
  sdhci_ops.read_l: esdhc_mcf_readl_be
  sdhci_ops.copy_to_bounce_buffer: esdhc_mcf_copy_to_bounce_buffer
  sdhci_ops.request_done: esdhc_mcf_request_done
  platform_driver.probe: sdhci_esdhc_mcf_probe
  platform_driver.remove: sdhci_esdhc_mcf_remove
callback_signatures:
  sdhci_ops.reset:
    type: "void (*)(struct sdhci_host *, unsigned char)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "unsigned char"
    variadic: false
  sdhci_ops.set_clock:
    type: "void (*)(struct sdhci_host *, unsigned int)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "unsigned int"
    variadic: false
  sdhci_ops.get_max_clock:
    type: "unsigned int (*)(struct sdhci_host *)"
    return_type: "unsigned int"
    params:
      - "struct sdhci_host *"
    variadic: false
  sdhci_ops.get_min_clock:
    type: "unsigned int (*)(struct sdhci_host *)"
    return_type: "unsigned int"
    params:
      - "struct sdhci_host *"
    variadic: false
  sdhci_ops.set_bus_width:
    type: "void (*)(struct sdhci_host *, int)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "int"
    variadic: false
  sdhci_ops.get_max_timeout_count:
    type: "unsigned int (*)(struct sdhci_host *)"
    return_type: "unsigned int"
    params:
      - "struct sdhci_host *"
    variadic: false
  sdhci_ops.set_timeout:
    type: "void (*)(struct sdhci_host *, struct mmc_command *)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "struct mmc_command *"
    variadic: false
  sdhci_ops.write_b:
    type: "void (*)(struct sdhci_host *, unsigned char, int)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "unsigned char"
      - "int"
    variadic: false
  sdhci_ops.write_w:
    type: "void (*)(struct sdhci_host *, unsigned short, int)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "unsigned short"
      - "int"
    variadic: false
  sdhci_ops.write_l:
    type: "void (*)(struct sdhci_host *, unsigned int, int)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "unsigned int"
      - "int"
    variadic: false
  sdhci_ops.read_b:
    type: "unsigned char (*)(struct sdhci_host *, int)"
    return_type: "unsigned char"
    params:
      - "struct sdhci_host *"
      - "int"
    variadic: false
  sdhci_ops.read_w:
    type: "unsigned short (*)(struct sdhci_host *, int)"
    return_type: "unsigned short"
    params:
      - "struct sdhci_host *"
      - "int"
    variadic: false
  sdhci_ops.read_l:
    type: "unsigned int (*)(struct sdhci_host *, int)"
    return_type: "unsigned int"
    params:
      - "struct sdhci_host *"
      - "int"
    variadic: false
  sdhci_ops.copy_to_bounce_buffer:
    type: "void (*)(struct sdhci_host *, struct mmc_data *, unsigned int)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "struct mmc_data *"
      - "unsigned int"
    variadic: false
  sdhci_ops.request_done:
    type: "void (*)(struct sdhci_host *, struct mmc_request *)"
    return_type: "void"
    params:
      - "struct sdhci_host *"
      - "struct mmc_request *"
    variadic: false
  platform_driver.probe:
    type: "int (*)(struct platform_device *)"
    return_type: "int"
    params:
      - "struct platform_device *"
    variadic: false
  platform_driver.remove:
    type: "void (*)(struct platform_device *)"
    return_type: "void"
    params:
      - "struct platform_device *"
    variadic: false
resources:
  cloc6:
    acquisition: "devm_clk_get"
    binds_to: "g->clk"
error_paths:
  - "return -EINVAL"
  - "return PTR_ERR(host)"
  - "return PTR_ERR(mcf_data->clk_ahb)"
  - "return PTR_ERR(mcf_data->clk_ipg)"
  - "return PTR_ERR(mcf_data->clk_per)"
helper_calls:
  - "clk_disable_unprepare"
  - "clk_prepare_enable"
