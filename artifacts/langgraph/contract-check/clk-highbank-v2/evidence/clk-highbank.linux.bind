backend linux for device clk-highbank {
  include <linux/io.h>
  include <linux/platform_device.h>
  type DeviceState -> "struct clk_highbank_priv"
  type MmioBase -> "void __iomem *"
  type LogicalIRQ -> "struct irq_data *"
  type UInt -> "u32"
  type UIntPtr -> "unsigned long *"
  callback clk_ops.prepare = clk_pll_prepare
  callback clk_ops.unprepare = clk_pll_unprepare
  callback clk_ops.enable = clk_pll_enable
  callback clk_ops.disable = clk_pll_disable
  callback clk_ops.recalc_rate = clk_pll_recalc_rate
  callback clk_ops.set_rate = clk_pll_set_rate
  callback clk_ops.recalc_rate = clk_cpu_periphclk_recalc_rate
  callback clk_ops.recalc_rate = clk_cpu_a9bclk_recalc_rate
  callback clk_ops.recalc_rate = clk_periclk_recalc_rate
  callback clk_ops.set_rate = clk_periclk_set_rate
  map dev.base -> "g->base"
  map MmioRead(B4) -> "readl"
  map MmioWrite(B4) -> "writel"
  map MmioRead(B2) -> "readw"
  map MmioWrite(B2) -> "writew"
  map MmioRead(B1) -> "readb"
  map MmioWrite(B1) -> "writeb"
  map MmioWriteW1C(B4) -> "writel"
  map MmioWriteW1C(B2) -> "writew"
  map MmioWriteW1C(B1) -> "writeb"
  map MmioReadBE(B2) -> "ioread16be"
  map MmioWriteBE(B2) -> "iowrite16be"
  map MmioReadBE(B4) -> "ioread32be"
  map MmioWriteBE(B4) -> "iowrite32be"
}
