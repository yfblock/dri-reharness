callbacks:
  irq_handler.handler: dwc2_handle_common_intr
  dev_pm_ops.suspend: dwc2_suspend
  dev_pm_ops.freeze: dwc2_suspend
  dev_pm_ops.poweroff: dwc2_suspend
  dev_pm_ops.resume: dwc2_resume
  dev_pm_ops.restore: dwc2_resume
  dev_pm_ops.thaw: dwc2_resume
  platform_driver.probe: dwc2_driver_probe
  platform_driver.remove: dwc2_driver_remove
  platform_driver.shutdown: dwc2_driver_shutdown
  usb_role_switch_desc.set: dwc2_drd_role_sw_set
  hc_driver.irq: _dwc2_hcd_irq
  hc_driver.start: _dwc2_hcd_start
  hc_driver.stop: _dwc2_hcd_stop
  hc_driver.urb_enqueue: _dwc2_hcd_urb_enqueue
  hc_driver.urb_dequeue: _dwc2_hcd_urb_dequeue
  hc_driver.endpoint_disable: _dwc2_hcd_endpoint_disable
  hc_driver.endpoint_reset: _dwc2_hcd_endpoint_reset
  hc_driver.get_frame_number: _dwc2_hcd_get_frame_number
  hc_driver.hub_status_data: _dwc2_hcd_hub_status_data
  hc_driver.hub_control: _dwc2_hcd_hub_control
  hc_driver.clear_tt_buffer_complete: _dwc2_hcd_clear_tt_buffer_complete
  hc_driver.bus_suspend: _dwc2_hcd_suspend
  hc_driver.bus_resume: _dwc2_hcd_resume
  hc_driver.map_urb_for_dma: dwc2_map_urb_for_dma
  hc_driver.unmap_urb_for_dma: dwc2_unmap_urb_for_dma
  hc_driver.free_dev: dwc2_free_dev
  hc_driver.reset_device: dwc2_reset_device
  hrtimer.function: dwc2_wait_timer_fn
  usb_request.complete: dwc2_hsotg_complete_setup
  usb_ep_ops.enable: dwc2_hsotg_ep_enable
  usb_ep_ops.disable: dwc2_hsotg_ep_disable_lock
  usb_ep_ops.alloc_request: dwc2_hsotg_ep_alloc_request
  usb_ep_ops.free_request: dwc2_hsotg_ep_free_request
  usb_ep_ops.queue: dwc2_hsotg_ep_queue_lock
  usb_ep_ops.dequeue: dwc2_hsotg_ep_dequeue
  usb_ep_ops.set_halt: dwc2_hsotg_ep_sethalt_lock
  usb_ep_ops.set_wedge: dwc2_gadget_ep_set_wedge
  usb_gadget_ops.get_frame: dwc2_hsotg_gadget_getframe
  usb_gadget_ops.set_selfpowered: dwc2_hsotg_set_selfpowered
  usb_gadget_ops.udc_start: dwc2_hsotg_udc_start
  usb_gadget_ops.udc_stop: dwc2_hsotg_udc_stop
  usb_gadget_ops.pullup: dwc2_hsotg_pullup
  usb_gadget_ops.udc_set_speed: dwc2_gadget_set_speed
  usb_gadget_ops.vbus_session: dwc2_hsotg_vbus_session
  usb_gadget_ops.vbus_draw: dwc2_hsotg_vbus_draw
resources:
  resource0:
    acquisition: "platform_get_irq"
  resource1:
    acquisition: "devm_request_irq"
  resource2:
    acquisition: "platform_get_resource"
error_paths:
  - "return -EAGAIN"
  - "return -EBUSY"
  - "return -EINVAL"
  - "return -EIO"
  - "return -ENODEV"
  - "return -ENOMEM"
  - "return -ENOSPC"
  - "return -ENOTSUPP"
  - "return PTR_ERR(hsotg->regs)"
helper_calls:
  - "clk_disable_unprepare"
  - "clk_prepare_enable"
