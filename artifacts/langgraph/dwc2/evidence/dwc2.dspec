  resource mmio0: MmioResource { required true bind base }
  resource clk0: ClockResource { required true bind clk }
  resource irq0: IrqResource { required true }
  register GOTGCTL: B4 at base + 0x0
  register GOTGINT: B4 at base + 0x4
  register GAHBCFG: B4 at base + 0x8
  register GUSBCFG: B4 at base + 0xc
  register GRSTCTL: B4 at base + 0x10
  register GINTSTS: B4 at base + 0x14
  register GINTMSK: B4 at base + 0x18
  register GRXSTSP: B4 at base + 0x20
  register GRXFSIZ: B4 at base + 0x24
  register GNPTXFSIZ: B4 at base + 0x28
  register GNPTXSTS: B4 at base + 0x2c
  register GI2CCTL: B4 at base + 0x30
  register GGPIO: B4 at base + 0x38
  register GSNPSID: B4 at base + 0x40
  register GHWCFG1: B4 at base + 0x44
  register GHWCFG2: B4 at base + 0x48
  register GHWCFG3: B4 at base + 0x4c
  register GHWCFG4: B4 at base + 0x50
  register GLPMCFG: B4 at base + 0x54
  register GPWRDN: B4 at base + 0x58
  register GDFIFOCFG: B4 at base + 0x5c
  register GREFCLK: B4 at base + 0x64
  register GINTMSK2: B4 at base + 0x68
  register GINTSTS2: B4 at base + 0x6c
  register HPTXFSIZ: B4 at base + 0x100
  register HCFG: B4 at base + 0x400
  register HFIR: B4 at base + 0x404
  register HFNUM: B4 at base + 0x408
  register HPTXSTS: B4 at base + 0x410
  register HAINT: B4 at base + 0x414
  register HAINTMSK: B4 at base + 0x418
  register HFLBADDR: B4 at base + 0x41c
  register HPRT0: B4 at base + 0x440
  register DCFG: B4 at base + 0x800
  register DCTL: B4 at base + 0x804
  register DSTS: B4 at base + 0x808
  register DIEPMSK: B4 at base + 0x810
  register DOEPMSK: B4 at base + 0x814
  register DAINT: B4 at base + 0x818
  register DAINTMSK: B4 at base + 0x81c
  register DIEPEMPMSK: B4 at base + 0x834
  register DIEPCTL0: B4 at base + 0x900
  register DOEPCTL0: B4 at base + 0xb00
  register DOEPTSIZ0: B4 at base + 0xb10
  register PCGCTL: B4 at base + 0xe00
  register PCGCCTL1: B4 at base + 0xe04
  invariant forall line: UInt. line < num_irqs -> valid_interrupt_line(line)
  function dwc2_backup_global_registers(hsotg: DeviceState) -> UInt {
    role helper
    source "core.c:37"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_backup_global_registers
  }
  function dwc2_restore_global_registers(hsotg: DeviceState) -> UInt {
    role helper
    source "core.c:70"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_restore_global_registers
    effect writes_register(GINTSTS)
    effect writes_register(GOTGCTL)
    effect writes_register(GINTMSK)
    effect writes_register(GUSBCFG)
    effect writes_register(GAHBCFG)
    effect writes_register(GRXFSIZ)
    effect writes_register(GNPTXFSIZ)
    effect writes_register(GDFIFOCFG)
    effect writes_register(PCGCCTL1)
    effect writes_register(GLPMCFG)
    effect writes_register(PCGCTL)
    effect writes_register(GI2CCTL)
  }
  function dwc2_enter_partial_power_down(hsotg: DeviceState) -> UInt {
    role helper
    source "core.c:132"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_enter_partial_power_down
  }
  function dwc2_restore_essential_regs(hsotg: DeviceState, rmode: UInt, is_host: UInt) -> Void {
    role helper
    source "core.c:147"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_restore_essential_regs
    effect writes_register(PCGCTL)
    effect writes_register(GAHBCFG)
    effect writes_register(GINTSTS)
    effect writes_register(GINTMSK)
    effect writes_register(GUSBCFG)
    effect writes_register(HCFG)
    effect writes_register(DCFG)
  }
  function dwc2_hib_restore_common(hsotg: DeviceState, rem_wakeup: UInt, is_host: UInt) -> Void {
    role helper
    source "core.c:215"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_hib_restore_common
    effect writes_register(GPWRDN)
    effect writes_register(GINTSTS)
  }
  function dwc2_core_reset(hsotg: DeviceState, skip_wait: UInt) -> UInt {
    role reset
    source "core.c:399"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_core_reset
    effect writes_register(GRSTCTL)
    effect resets_device()
    ensure device_state == RESET
  }
  function dwc2_clear_force_mode(hsotg: DeviceState) -> Void {
    role helper
    source "core.c:556"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_clear_force_mode
    effect writes_register(GUSBCFG)
  }
  function dwc2_force_dr_mode(hsotg: DeviceState) -> Void {
    role helper
    source "core.c:577"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_force_dr_mode
  }
  function dwc2_is_controller_alive(hsotg: DeviceState) -> UInt {
    role helper
    source "core.c:840"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_is_controller_alive
  }
  function dwc2_disable_global_interrupts(hsotg: DeviceState) -> Void {
    role helper
    source "core.c:868"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_disable_global_interrupts
    effect writes_register(GAHBCFG)
  }
  function dwc2_hw_is_host(hsotg: DeviceState) -> UInt {
    role helper
    source "core.c:896"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_hw_is_host
  }
  function dwc2_hw_is_device(hsotg: DeviceState) -> UInt {
    role helper
    source "core.c:905"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_hw_is_device
  }
  function dwc2_set_clock_switch_timer(hsotg: DeviceState) -> Void {
    role helper
    source "core.c:985"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_set_clock_switch_timer
    effect writes_register(GRSTCTL)
  }
  function dwc2_phy_init(hsotg: DeviceState, select_phy: UInt) -> UInt {
    role init
    source "core.c:1167"
    context thread
    bind dev: DeviceState from hsotg
    bind base: MmioBase from hsotg->regs
    ris dwc2_phy_init
    effect writes_register(GUSBCFG)
    effect initializes_device()
    ensure device_state == READY
  }
  function dwc2_handle_usb_port_intr(hsotg: DeviceState) -> Void {
    role helper
    source "core_intr.c:52"
    context thread
