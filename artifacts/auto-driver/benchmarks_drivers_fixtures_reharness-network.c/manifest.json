{
  "compile": {
    "backend": "linux",
    "context": "kbuild",
    "language": "c"
  },
  "limits": {
    "compile": 3,
    "runtime": 3,
    "trace": 3
  },
  "name": "reharness_network",
  "runtime": {
    "adapter": "qemu-profile",
    "capabilities": {
      "optional": [
        "trace"
      ],
      "required": [
        "registration",
        "probe",
        "subsystem",
        "unload"
      ]
    },
    "fixture": {
      "config": {},
      "kind": "qemu-network"
    },
    "profile": "network-generic",
    "qemu": {
      "bus": "network",
      "device": "network-stack",
      "machine": "pc",
      "module": "reharness_network",
      "probe_pattern": "REHARNESS_NETWORK_REGISTERED|REHARNESS_NETWORK_OPEN",
      "timeout_seconds": 90
    }
  },
  "schema": 2,
  "source": {
    "path": "benchmarks/drivers/fixtures/reharness-network.c",
    "sha256": "e596c53aaf4187f0f4d4ca074e1863d6f0e2f540462e4e6197f395c880958e34"
  },
  "test": {
    "subsystem": {
      "name": "network",
      "tests": [
        {
          "args": [
            "eth"
          ],
          "executable": "qa/native-tests/network_device_test.c",
          "name": "network-interface",
          "success_pattern": "NETWORK_INTERFACE_PASS"
        },
        {
          "executable": "vendor/linux/tools/testing/selftests/net/netdevice.sh",
          "kind": "kselftest",
          "name": "linux-netdevice-selftest",
          "provider": "linux-netdevice-selftest",
          "required": false
        }
      ]
    }
  },
  "trace": {
    "fields": [
      "phase",
      "function",
      "kind",
      "width_bits",
      "address",
      "value",
      "sequence"
    ]
  }
}
