    effect initializes_device()
    ensure device_state == READY
  }
  function dw_spi_elba_set_cs(spi: DeviceState, enable: UInt) -> Void {
    role write_config
    source "spi-dw-mmio.c:276"
    context thread
    callback dw_spi.set_cs
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_elba_set_cs
    effect updates_transaction(regmap)
