  function dw_spi_mmio_probe(pdev: DeviceState) -> UInt {
    role probe
    source "spi-dw-mmio.c:313"
    context boot
    callback platform_driver.probe
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    require resources_available
    ris dw_spi_mmio_probe
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
    effect writes_register(DW_SPI_TXFTLR)
    effect writes_register(DW_SPI_CTRLR0)
    effect writes_register(DW_SPI_CS_OVERRIDE)
    effect initializes_device()
    ensure device_state == READY
  }
  function dw_spi_mmio_suspend(dev: DeviceState) -> UInt {
    role suspend
    source "spi-dw-mmio.c:393"
    context sleepable
