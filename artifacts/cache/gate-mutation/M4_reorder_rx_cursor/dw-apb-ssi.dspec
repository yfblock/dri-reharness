  function dw_spi_sparx5_set_cs(spi: DeviceState, enable: UInt) -> Void {
    role write_config
    source "spi-dw-mmio.c:148"
    context thread
    callback dw_spi.set_cs
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_sparx5_set_cs
    effect writes_transaction(regmap)
    effect writes_transaction(regmap)
    effect writes_register(DW_SPI_SER)
    effect writes_config(offset)
  }
  function dw_spi_mscc_sparx5_init(pdev: DeviceState, dwsmmio: DeviceState) -> UInt {
