device dw-apb-ssi {
  class generic_mmio
  source "/home/yfblock/Code/dri-trans-paper/reharness/benchmarks/drivers/multisource/dw-apb-ssi.json"
  state {
    base: MmioBase
    clk: Clock
    num_irqs: UInt
    dws->ctlr->cur_msg->status: UInt
    dws->rx: UInt
    dws->rx_len: UInt
    dws->tx: UInt
    dws->tx_len: UInt
    dws->dma_mapped: UInt
    dws->current_freq: UInt
    dws->cur_rx_sample_dly: UInt
    transfer->effective_speed_hz: UInt
    delay.unit: UInt
    delay.value: UInt
    dws->transfer_handler: UInt
    dws->n_bytes: UInt
    cfg.dfs: UInt
    cfg.tmode: UInt
    cfg.ndf: UInt
    spi->controller_state: UInt
    dwsmmio->dws.set_cs: UInt
    dwsmmio->priv: UInt
    dwsmmio->dws.caps: UInt
    dwsmmio->dws.ip: UInt
    dwsmmio->dws.fifo_len: UInt
    dws->paddr: UInt
    dws->bus_num: UInt
    dws->reg_io_width: UInt
    dws->ctlr: UInt
    dws->dma_addr: UInt
    dws->num_cs: UInt
    dws->fifo_len: UInt
    dws->caps: UInt
    dws->mem_ops.adjust_op_size: UInt
    dws->mem_ops.supports_op: UInt
    dws->mem_ops.exec_op: UInt
    dws->max_mem_freq: UInt
    ctlr->mode_bits: UInt
    ctlr->bus_num: UInt
    ctlr->num_chipselect: UInt
    ctlr->setup: UInt
    ctlr->cleanup: UInt
    ctlr->transfer_one: UInt
    ctlr->handle_err: UInt
    ctlr->auto_runtime_pm: UInt
    ctlr->use_gpio_descriptors: UInt
    ctlr->set_cs: UInt
    ctlr->mem_ops: UInt
    ctlr->mem_caps: UInt
    ctlr->max_speed_hz: UInt
    ctlr->flags: UInt
    ctlr->target_abort: UInt
    ctlr->can_dma: UInt
    flags: UInt
    dws->regset.regs: UInt
    dws->regset.base: UInt
    dwsmmio->dws.num_cs: UInt
  }
  resource transaction0: TransactionResource { required true bind regmap }
  resource clk0: ClockResource { required true bind clk }
  resource irq0: IrqResource { required true }
  register DW_SPI_CTRLR0: B4 at base + 0x0
  register DW_SPI_CTRLR1: B4 at base + 0x4
  register DW_SPI_SSIENR: B4 at base + 0x8
  register DW_SPI_SER: B4 at base + 0x10
  register DW_SPI_BAUDR: B4 at base + 0x14
  register MSCC_SPI_MST_SW_MODE: B4 at base + 0x14
  register DW_SPI_TXFTLR: B4 at base + 0x18
  register DW_SPI_RXFTLR: B4 at base + 0x1c
  register DW_SPI_TXFLR: B4 at base + 0x20
  register DW_SPI_RXFLR: B4 at base + 0x24
  register DW_SPI_SR: B4 at base + 0x28
  register DW_SPI_IMR: B4 at base + 0x2c
  register DW_SPI_ISR: B4 at base + 0x30
  register DW_SPI_RISR: B4 at base + 0x34
  register DW_SPI_ICR: B4 at base + 0x48
  register DW_SPI_VERSION: B4 at base + 0x5c
  register DW_SPI_RX_SAMPLE_DLY: B4 at base + 0xf0
  register DW_SPI_CS_OVERRIDE: B4 at base + 0xf4
  invariant forall line: UInt. line < num_irqs -> valid_interrupt_line(line)
  function dw_spi_set_cs(spi: DeviceState, enable: UInt) -> Void {
    role write_config
    source "spi-dw-core.c:90"
    context thread
    callback spi_controller.set_cs
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_set_cs
    effect writes_register(DW_SPI_SER)
    effect writes_config(offset)
  }
  function dw_spi_transfer_handler(dws: DeviceState) -> UInt {
    role interrupt_handler
    source "spi-dw-core.c:213"
    context irq
    callback dw_spi.transfer_handler
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_transfer_handler
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
    effect writes_register(DW_SPI_RXFTLR)
    effect handles_interrupt()
    ensure interrupt_serviced
  }
  function dw_spi_irq(irq: UInt, dev_id: DeviceState) -> UInt {
    role interrupt_handler
    source "spi-dw-core.c:251"
    context irq
    callback irq_handler.handler
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_irq
    effect writes_register(DW_SPI_IMR)
    effect handles_interrupt()
    ensure interrupt_serviced
  }
  function dw_spi_transfer_one(ctlr: DeviceState, spi: DeviceState, transfer: DeviceState) -> UInt {
    role setup_queue
    source "spi-dw-core.c:416"
    context thread
    callback spi_controller.transfer_one
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_transfer_one
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_CTRLR0)
    effect writes_register(DW_SPI_CTRLR1)
    effect writes_register(DW_SPI_BAUDR)
    effect writes_register(DW_SPI_RX_SAMPLE_DLY)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
    effect writes_register(DW_SPI_TXFTLR)
    effect writes_register(DW_SPI_RXFTLR)
    effect configures_queue(queue)
    ensure queue_ready[queue] == true
  }
  function dw_spi_handle_err(ctlr: DeviceState, msg: DeviceState) -> Void {
    role reset
    source "spi-dw-core.c:478"
    context thread
    callback spi_controller.handle_err
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_handle_err
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
    effect resets_device()
    ensure device_state == RESET
  }
  function dw_spi_target_abort(ctlr: DeviceState) -> UInt {
    role reset
    source "spi-dw-core.c:484"
    context thread
    callback spi_controller.target_abort
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_target_abort
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
    effect resets_device()
    ensure device_state == RESET
  }
  function dw_spi_exec_mem_op(mem: DeviceState, op: DeviceState) -> UInt {
    role write_config
    source "spi-dw-core.c:675"
    context thread
    callback spi_controller_mem_ops.exec_op
    bind dev: DeviceState from dws
    bind base: MmioBase from dws->regs
    ris dw_spi_exec_mem_op
    effect writes_register(DW_SPI_SSIENR)
    effect writes_register(DW_SPI_CTRLR0)
    effect writes_register(DW_SPI_CTRLR1)
    effect writes_register(DW_SPI_BAUDR)
    effect writes_register(DW_SPI_RX_SAMPLE_DLY)
    effect writes_register(DW_SPI_IMR)
    effect writes_register(DW_SPI_SER)
    effect writes_config(offset)
  }
  function dw_spi_setup(spi: DeviceState) -> UInt {
    role init
    source "spi-dw-core.c:789"
    context thread
    callback spi_controller.setup
    ris dw_spi_setup
    effect initializes_device()
    ensure device_state == READY
  }
  function dw_spi_cleanup(spi: DeviceState) -> Void {
    role remove
    source "spi-dw-core.c:825"
    context thread
    callback spi_controller.cleanup
    ris dw_spi_cleanup
    effect releases_device()
    ensure device_state == OFF
  }
  function dw_spi_mscc_set_cs(spi: DeviceState, enable: UInt) -> Void {
    role write_config
    source "spi-dw-mmio.c:77"
    context thread
    callback dw_spi.set_cs
    bind dev: DeviceState from dwsmscc
    bind base: MmioBase from dwsmscc->spi_mst
    ris dw_spi_mscc_set_cs
    effect writes_register(MSCC_SPI_MST_SW_MODE)
    effect writes_register(DW_SPI_SER)
    effect writes_config(offset)
  }
  function dw_spi_mscc_ocelot_init(pdev: DeviceState, dwsmmio: DeviceState) -> UInt {
    role init
    source "spi-dw-mmio.c:128"
    context thread
    callback of_device_id.data
    bind dev: DeviceState from dwsmscc
    bind base: MmioBase from dwsmscc->spi_mst
    ris dw_spi_mscc_ocelot_init
    effect writes_register(MSCC_SPI_MST_SW_MODE)
    effect updates_transaction(regmap)
    effect initializes_device()
    ensure device_state == READY
  }
  function dw_spi_mscc_jaguar2_init(pdev: DeviceState, dwsmmio: DeviceState) -> UInt {
    role init
    source "spi-dw-mmio.c:135"
    context thread
    callback of_device_id.data
