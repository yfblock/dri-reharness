backend harness for device dw-apb-ssi {
  type DeviceState -> "struct dw_apb_ssi_priv"
  type MmioBase -> "uintptr_t"
  type LogicalIRQ -> "unsigned int"
  type UInt -> "uint32_t"
  type UIntPtr -> "uint32_t *"
  map dev.base -> "dev->base"
  map MmioRead(B4) -> "harness_read32"
  map MmioWrite(B4) -> "harness_write32"
  map MmioRead(B2) -> "harness_read16"
  map MmioWrite(B2) -> "harness_write16"
  map MmioRead(B1) -> "harness_read8"
  map MmioWrite(B1) -> "harness_write8"
  map MmioWriteW1C(B4) -> "harness_write_w1c32"
  map MmioWriteW1C(B2) -> "harness_write_w1c16"
  map MmioWriteW1C(B1) -> "harness_write_w1c8"
  map MmioReadBE(B2) -> "harness_read16be"
  map MmioWriteBE(B2) -> "harness_write16be"
  map MmioReadBE(B4) -> "harness_read32be"
  map MmioWriteBE(B4) -> "harness_write32be"
}
